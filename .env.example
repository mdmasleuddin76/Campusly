# Copy to .env on the server and fill in. Never commit .env.
# Generate secrets on the server with:  openssl rand -hex 32

# Port on the server where the app listens (localhost only)
APP_PORT=8085

# Public address of the site
CLIENT_URL=https://campusly.maslecodes.fun

# MongoDB login (created automatically the first time the database starts).
# Use letters and numbers only (openssl rand -hex gives you that).
MONGO_ROOT_USER=campusly_admin
MONGO_ROOT_PASSWORD=

# Long random string for signing login tokens
JWT_SECRET=
JWT_EXPIRES_IN=1d

# TPO account created by the seed command
TPO_NAME=TPO Admin
TPO_EMAIL=
TPO_PASSWORD=

# Leave empty: the frontend calls /api on the same domain
VITE_API_URL=
